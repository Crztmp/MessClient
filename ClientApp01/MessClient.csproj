<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net7.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <EnableDefaultItemSpecs>false</EnableDefaultItemSpecs>
  </PropertyGroup>
<PropertyGroup>
  <Version>1.0.0</Version>
  <AssemblyVersion>1.0.0.0</AssemblyVersion>
  <FileVersion>1.0.0.0</FileVersion>
  <InformationalVersion>1.0.0</InformationalVersion>
</PropertyGroup>
  <ItemGroup>
    <!-- Application Definition -->
    <ApplicationDefinition Include="App.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </ApplicationDefinition>
    <Compile Include="App.xaml.cs">
      <DependentUpon>App.xaml</DependentUpon>
    </Compile>
    <Compile Include="Controls\ContactItemStyleSelector.cs" />
    <Compile Include="Converters\BooleanToVisibilityConverter.cs">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Compile>
    <Compile Include="Converters\GroupHeaderConverter.cs" />
    <Compile Include="Converters\MessageAlignmentConverter.cs" />
    <Compile Include="Converters\MessageBackgroundConverter.cs" />
    <Compile Include="Models\Chat.cs" />
    <Compile Include="Models\Contact.cs" />
    <Compile Include="Models\DTOs\AddChatDto.cs" />
    <Compile Include="Models\DTOs\AddContactDto.cs" />
    <Compile Include="Models\DTOs\CreateChatDto.cs" />
    <Compile Include="Models\DTOs\CurrentWindowCloseDto.cs" />
    <Compile Include="Models\DTOs\UpdateContactDto.cs" />
    <Compile Include="Models\UserDataResponse.cs" />
    <Compile Include="ViewModels\AddContactViewModel.cs" />
    <Compile Include="ViewModels\ContactChatPropertiesViewModel.cs" />
    <Compile Include="ViewModels\ContactPropertiesViewModel.cs" />
    <Compile Include="ViewModels\CreateChatDialogViewModel.cs" />
    <Compile Include="ViewModels\AddChatDialogViewModel.cs" />
    <Compile Include="ViewModels\LoginSettingsViewModel.cs" />
    <Compile Include="ViewModels\RegisterViewModel.cs" />
    <Compile Include="Views\AddContactDialog.xaml.cs" />
    <Compile Include="Views\ContactChatPropertiesDialog.xaml.cs" />
    <Compile Include="Views\ContactPropertiesDialog.xaml.cs" />
    <Compile Include="Views\CreateChatDialog.xaml.cs" />
    <Compile Include="Views\AddChatDialog.xaml.cs" />
    <Compile Include="Views\LoginSettingsWindow.xaml.cs" />
    <Compile Include="Views\RegisterWindow.xaml.cs" />

    <!-- Configuration -->
    <Content Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>

    <!-- Ресурсы (теперь без дублирования) -->
    <EmbeddedResource Include="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>

    <!-- Настройки -->
    <None Include="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
    <Compile Include="Properties\Settings.Designer.cs">
      <DependentUpon>Settings.settings</DependentUpon>
      <AutoGen>True</AutoGen>
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
    </Compile>

    <!-- Properties -->
    <Compile Include="Properties\Resources.Designer.cs">
      <DependentUpon>Resources.resx</DependentUpon>
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
    </Compile>
    <Compile Include="Properties\Settings.Designer.cs">
      <DependentUpon>Settings.settings</DependentUpon>
      <AutoGen>True</AutoGen>
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
    </Compile>
    <None Include="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>

    <!-- Models -->
    <Compile Include="Models\AuthResponse.cs" />
    <Compile Include="Models\Message.cs" />
    <Compile Include="Models\User.cs" />
    <Compile Include="Models\State\AppState.cs" />

    <!-- Services -->
    <Compile Include="Services\ApiService.cs" />
    <Compile Include="Services\AuthService.cs" />
    <Compile Include="Services\ChatHubService.cs" />
    <Compile Include="Services\NavigationService.cs" />

    <!-- Converters -->

    <!-- ViewModels -->
    <Compile Include="ViewModels\LoginViewModel.cs" />
    <Compile Include="ViewModels\MainViewModel.cs" />
    <Compile Include="ViewModels\ViewModelLocator.cs" />
    <Page Include="Views\AddContactDialog.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Include="Views\ContactChatPropertiesDialog.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Include="Views\ContactPropertiesDialog.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Include="Views\CreateChatDialog.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Include="Views\AddChatDialog.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Include="Views\LoginSettingsWindow.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>

    <!-- Views -->
    <Page Include="Views\LoginWindow.xaml">
      <SubType>Designer</SubType>
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Compile Include="Views\LoginWindow.xaml.cs">
      <DependentUpon>LoginWindow.xaml</DependentUpon>
    </Compile>

    <Page Include="Views\MainWindow.xaml">
      <SubType>Designer</SubType>
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Compile Include="Views\MainWindow.xaml.cs">
      <DependentUpon>MainWindow.xaml</DependentUpon>
    </Compile>

    <Page Include="Views\Controls\MessageBubble.xaml">
      <SubType>Designer</SubType>
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Compile Include="Views\Controls\MessageBubble.xaml.cs">
      <DependentUpon>MessageBubble.xaml</DependentUpon>
    </Compile>

    <!-- Styles -->
    <Page Include="Assets\Styles\MainStyles.xaml">
      <SubType>Designer</SubType>
      <Generator>MSBuild:Compile</Generator>
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Page>
    <Page Include="Views\RegisterWindow.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>

    <!-- Empty Folders -->
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="MaterialDesignColors" Version="5.2.1" />
    <PackageReference Include="MaterialDesignThemes" Version="5.2.1" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="7.0.20" />
    <PackageReference Include="Microsoft.Data.Tools.Msbuild" Version="16.0.62004.28040" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="7.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="7.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="7.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="7.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="7.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="7.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="7.0.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="System.DirectoryServices.AccountManagement" Version="7.0.1" />
  </ItemGroup>

</Project>