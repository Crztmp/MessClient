<Window x:Class="ClientApp01.Views.AddContactDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Добавить контакт" Height="400" Width="400"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <StackPanel>
            <TextBox materialDesign:HintAssist.Hint="Поиск пользователей"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>

            <Button Content="Поиск" 
                    Command="{Binding SearchCommand}"
                    Margin="0,5,0,10"/>

            <ListBox ItemsSource="{Binding SearchResults}" 
                     Height="200" 
                     SelectedItem="{Binding SelectedUser, Mode=TwoWay}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="30" Height="30" 
                                     Fill="{DynamicResource PrimaryHueLightBrush}"
                                     Margin="0,0,10,0"/>
                            <StackPanel>
                                <TextBlock Text="{Binding Username}" FontWeight="Bold"/>
                                <TextBlock Text="{Binding DisplayName}" Foreground="Gray"/>
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBox materialDesign:HintAssist.Hint="Отображаемое имя (необязательно)"
                     Text="{Binding CustomName, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,10,0,10"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Отмена" 
                        Click="Cancel_Click" 
                        Margin="0,0,10,0"
                        Style="{StaticResource MaterialDesignFlatButton}"/>
                <Button Content="Добавить" 
                        Click="Add_Click" 
                        IsEnabled="{Binding CanAdd}"
                        Style="{StaticResource MaterialDesignRaisedButton}"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>