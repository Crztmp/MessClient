<Window x:Class="ClientApp01.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Messenger - Вход"
        Height="500" Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        DataContext="{Binding LoginViewModel, Source={StaticResource Locator}}">

	<Window.Resources>
		<Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignTextBox}">
			<Setter Property="Margin" Value="0,10,0,0"/>
		</Style>
		<Style TargetType="PasswordBox" BasedOn="{StaticResource MaterialDesignPasswordBox}">
			<Setter Property="Margin" Value="0,10,0,0"/>
		</Style>
	</Window.Resources>

	<Grid Margin="20">
		<StackPanel VerticalAlignment="Center">
            <!-- Настройки -->
            <Button Style="{StaticResource MaterialDesignIconButton}"
        HorizontalAlignment="Right"
        Margin="0,0,0,10"
        Command="{Binding OpenSettingsCommand}">
                <materialDesign:PackIcon Kind="Cog" Width="24" Height="24"/>
            </Button>
            <!-- Логотип -->
			<Viewbox Height="80" Margin="0,0,0,30">
				<TextBlock Text="✉️" FontSize="40"/>
			</Viewbox>
            
            <!-- Заголовок -->
			<TextBlock Text="Добро пожаловать"
                       FontSize="22"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"/>
            <!-- Checkbox for current user login -->
            <CheckBox Content="Войти как текущий пользователь Windows"
                      IsChecked="{Binding UseCurrentWindowsUser}"
                      Command="{Binding CheckCurrentUserCommand}"
                      Margin="0,0,0,10"/>
			<!-- Поля ввода -->
			<TextBox materialDesign:HintAssist.Hint="Логин"
                     Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                     IsEnabled="{Binding IsManualLoginEnabled}"
                     x:Name="UsernameBox"/>

			<PasswordBox materialDesign:HintAssist.Hint="Пароль"
                         IsEnabled="{Binding IsManualLoginEnabled}"
                         x:Name="PasswordBox"/>

			<!-- Ошибка -->
			<TextBlock Text="{Binding ErrorMessage}"
                       Foreground="Red"
                       Margin="0,15,0,0"
                       TextWrapping="Wrap"
                       Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}"/>

			<!-- Кнопка входа -->
			<Button Content="Войти"
                    Command="{Binding LoginCommand}"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Margin="0,30,0,0"
                    Padding="20,5"
                    HorizontalAlignment="Stretch"/>

			<!-- Ссылка на регистрацию -->
			<TextBlock Margin="0,20,0,0" HorizontalAlignment="Center">
				<Hyperlink Command="{Binding NavigateToRegisterCommand}">
					Нет аккаунта? Зарегистрироваться
				</Hyperlink>
			</TextBlock>

			<!-- Прогресс-бар -->
			<ProgressBar IsIndeterminate="True"
                         Height="5"
                         Margin="0,20,0,0"
                         Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
		</StackPanel>
	</Grid>
</Window>