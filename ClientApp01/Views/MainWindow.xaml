<Window x:Class="ClientApp01.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:ClientApp01.Views.Controls"
        xmlns:controls="clr-namespace:ClientApp01.Views.Controls"
        xmlns:converters="clr-namespace:ClientApp01.Converters"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:componentModel="clr-namespace:System.ComponentModel;assembly=WindowsBase"
        Title="Messenger" Height="600" Width="1000"
        DataContext="{Binding MainViewModel, Source={StaticResource Locator}}">
    <Window.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:MessageAlignmentConverter x:Key="AlignmentConverter"/>
        <converters:GroupHeaderConverter x:Key="GroupHeaderConverter"/>
        <CollectionViewSource x:Key="GroupedChats" Source="{Binding Chats}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Added" />
            </CollectionViewSource.GroupDescriptions>
            <CollectionViewSource.SortDescriptions>
                <!-- First sort by Added (true first) -->
                <componentModel:SortDescription PropertyName="Added" Direction="Descending"/>
                <!-- Then by LastMessageTime (descending) for added chats -->
                <componentModel:SortDescription PropertyName="LastMessageTime" Direction="Descending"/>
                <!-- Then by AddedDate (descending) for chats without messages -->
                <componentModel:SortDescription PropertyName="AddedDate" Direction="Descending"/>
            </CollectionViewSource.SortDescriptions>
        </CollectionViewSource>
        <CollectionViewSource x:Key="GroupedContacts" Source="{Binding Contacts}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Added" />
            </CollectionViewSource.GroupDescriptions>
            <CollectionViewSource.SortDescriptions>
                <!-- First sort by Added (true first) -->
                <componentModel:SortDescription PropertyName="Added" Direction="Descending"/>
                <!-- Then by LastMessageTime (descending) for added contacts -->
                <componentModel:SortDescription PropertyName="LastMessageTime" Direction="Descending"/>
                <!-- Then by AddedDate (descending) for contacts without messages -->
                <componentModel:SortDescription PropertyName="AddedDate" Direction="Descending"/>
            </CollectionViewSource.SortDescriptions>
        </CollectionViewSource>

        <!-- Style for group headers -->
        <Style x:Key="ContactGroupHeaderStyle" TargetType="{x:Type GroupItem}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type GroupItem}">
                        <StackPanel>
                            <!-- Separator with text -->
                            <Border Background="{DynamicResource MaterialDesignDivider}" 
                                Padding="5" Margin="0,10,0,5">
                                <TextBlock Text="{Binding Name, 
                                        Converter={StaticResource GroupHeaderConverter}}"
                                       FontWeight="Bold"/>
                            </Border>
                            <ItemsPresenter/>
                        </StackPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style for non-added contacts -->
        <Style x:Key="NonAddedContactStyle" TargetType="ListBoxItem" BasedOn="{StaticResource MaterialDesignListBoxItem}">
            <Setter Property="Opacity" Value="0.8"/>
            <Setter Property="Background" Value="{DynamicResource MaterialDesignBackground}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}"
                            Padding="5">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="40" Height="40" 
                                     Fill="{DynamicResource PrimaryHueDarkBrush}"/>
                                <StackPanel Margin="10,0,0,0">
                                    <TextBlock Text="{Binding DisplayName, FallbackValue='Unknown'}"
                                           FontWeight="Bold"
                                           Foreground="#FF0A246A"/>
                                    <!-- Dark blue color -->
                                    <TextBlock Text="{Binding LastMessageTime, FallbackValue='No messages'}"
                                           Foreground="Gray"
                                           FontSize="10"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Боковая панель с чатами и контактами -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Текущий пользователь -->
            <Border Grid.Row="0" Background="{DynamicResource PrimaryHueLightBrush}" Padding="10">
                <StackPanel Orientation="Horizontal">
                  
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="CurrentUserDisplayName"
                                   Text="{Binding CurrentUser.DisplayName}" 
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryHueLightForegroundBrush}"/>
                        <TextBlock x:Name="CurrentUserUsername"
                                   Text="{Binding CurrentUser.Username}"
                                   Foreground="{DynamicResource PrimaryHueLightForegroundBrush}"
                                   FontSize="12"/>
                    </StackPanel>
                    <Button Command="{Binding LogoutCommand}"
                            Style="{StaticResource MaterialDesignIconButton}"
                            Margin="10,0,0,0"
                            ToolTip="Выход">
                        <materialDesign:PackIcon Kind="Logout" 
                                                 Foreground="{DynamicResource PrimaryHueLightForegroundBrush}"/>
                    </Button>
                </StackPanel>
            </Border>

            <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
                <TabItem Header="Чаты">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Поиск чатов -->
                        <StackPanel Grid.Row="0" Margin="10">
                            <TextBox materialDesign:HintAssist.Hint="Поиск чатов..." 
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                        </StackPanel>

                        <!-- Список чатов -->
                        <ListBox Grid.Row="1" 
                                 ItemsSource="{Binding Source={StaticResource GroupedChats}}" 
                                 SelectedItem="{Binding SelectedChat}">
                            <ListBox.GroupStyle>
                                <GroupStyle ContainerStyle="{StaticResource ContactGroupHeaderStyle}"/>
                            </ListBox.GroupStyle>
                            <ListBox.ItemContainerStyleSelector>
                                <local:ContactItemStyleSelector 
                                    NonAddedStyle="{StaticResource NonAddedContactStyle}"
                                    DefaultStyle="{StaticResource {x:Type ListBoxItem}}"/>
                            </ListBox.ItemContainerStyleSelector>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    <Setter Property="ContextMenu">
                                        <Setter.Value>
                                            <ContextMenu>
                                                <MenuItem Header="Properties" 
                                                          Command="{Binding PlacementTarget.Tag.ShowContactChatPropertiesCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding}"/>
                                                <MenuItem Header="Do Not Disturb" 
                                                          Command="{Binding PlacementTarget.Tag.SetChatDoNotDisturbCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding}"/>
                                            </ContextMenu>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="5">
                                        <Ellipse Width="40" Height="40" 
                                                 Fill="{DynamicResource PrimaryHueLightBrush}"/>
                                        <StackPanel Margin="10,0,0,0">
                                            <TextBlock Text="{Binding DisplayName, FallbackValue='Unknown'}"
                                                       FontWeight="Bold"/>
                                            <TextBlock Text="{Binding LastMessageTime, FallbackValue='No messages'}"
                                                       Foreground="Gray"
                                                       FontSize="10"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Кнопка создания чата -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="5">
                            <Button Content="Добавить чат" 
                                    Command="{Binding AddChatCommand}"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    Margin="0,0,10,0"/>
                            <Button Content="Создать чат" 
                                    Command="{Binding CreateChatCommand}"
                                    Style="{StaticResource MaterialDesignFlatButton}"/>
                        </StackPanel>
                    </Grid>
                </TabItem>

                <TabItem Header="Контакты">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Поиск контактов -->
                        <StackPanel Grid.Row="0" Margin="10">
                            <TextBox materialDesign:HintAssist.Hint="Поиск контактов..." 
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                        </StackPanel>

                        <!-- Список контактов -->
                        <ListBox Grid.Row="1" 
                                 ItemsSource="{Binding Source={StaticResource GroupedContacts}}" 
                                 SelectedItem="{Binding SelectedContact}"
                                 ContextMenuOpening="ContactsList_ContextMenuOpening">
                            <ListBox.GroupStyle>
                                <GroupStyle ContainerStyle="{StaticResource ContactGroupHeaderStyle}"/>
                            </ListBox.GroupStyle>
                            <ListBox.ItemContainerStyleSelector>
                                <local:ContactItemStyleSelector 
                                    NonAddedStyle="{StaticResource NonAddedContactStyle}"
                                    DefaultStyle="{StaticResource {x:Type ListBoxItem}}"/>
                            </ListBox.ItemContainerStyleSelector>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    <Setter Property="ContextMenu">
                                        <Setter.Value>
                                            <ContextMenu>
                                                <MenuItem Header="Properties" 
                                                          Command="{Binding PlacementTarget.Tag.ShowContactPropertiesCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding}"/>
                                                <MenuItem Header="Remove from Contacts" 
                                                          Command="{Binding PlacementTarget.Tag.DeleteContactCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding}"/>
                                            </ContextMenu>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="5">
                                        <Ellipse Width="40" Height="40" 
                                                 Fill="{DynamicResource PrimaryHueLightBrush}"/>
                                        <StackPanel Margin="10,0,0,0">
                                            <TextBlock Text="{Binding DisplayName, FallbackValue='Unknown'}"
                                                       FontWeight="Bold"/>
                                            <TextBlock Text="{Binding LastMessageTime, FallbackValue='No messages'}"
                                                       Foreground="Gray"
                                                       FontSize="10"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Кнопка добавления контакта -->
                        <Button Grid.Row="2" Content="Добавить контакт" 
                                Command="{Binding AddContactCommand}"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Margin="5"/>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- Основная область с сообщениями -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Заголовок чата/контакта -->
            <Border Grid.Row="0" Background="{DynamicResource PrimaryHueLightBrush}" Padding="10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding SelectedContact.DisplayName}" FontSize="16" FontWeight="Bold" 
                   Foreground="{DynamicResource PrimaryHueLightForegroundBrush}"/>
                </StackPanel>
            </Border>

            <!-- Список сообщений -->
            <ScrollViewer x:Name="MessagesScrollViewer" 
              Grid.Row="1" 
              VerticalScrollBarVisibility="Auto" 
              Padding="10">
                <ItemsControl ItemsSource="{Binding Messages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <controls:MessageBubble Margin="0,5" 
                    HorizontalAlignment="{Binding IsMyMessage, Converter={StaticResource AlignmentConverter}}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Панель ввода сообщения -->
            <Border Grid.Row="2" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,1,0,0" Padding="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="MessageBox" 
                             materialDesign:HintAssist.Hint="Введите сообщение..." 
                             Text="{Binding CurrentMessage, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                             MaxHeight="100" VerticalContentAlignment="Top"/>

                    <Button Grid.Column="1" Content="Отправить" 
                            Command="{Binding SendCommand}" 
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Margin="10,0,0,0" Padding="20,5"
                            IsEnabled="{Binding CurrentMessage, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>