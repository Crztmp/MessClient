<UserControl x:Class="ClientApp01.Views.Controls.MessageBubble"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:ClientApp01.Converters"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="60" d:DesignWidth="300">

    <UserControl.Resources>
        <converters:MessageBackgroundConverter x:Key="MessageBackgroundConverter"/>
        <converters:MessageAlignmentConverter x:Key="MessageAlignmentConverter"/>
    </UserControl.Resources>

    <Grid>
		<Border CornerRadius="10"
                Padding="10"
                Background="{Binding IsMyMessage, Converter={StaticResource MessageBackgroundConverter}}"
                HorizontalAlignment="{Binding IsMyMessage, Converter={StaticResource MessageAlignmentConverter}}">

			<StackPanel>
				<TextBlock Text="{Binding SenderName}"
                           FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryHueMidForegroundBrush}"/>

                <TextBlock Text="{Binding MessageText}"
                           TextWrapping="Wrap"
                           Margin="0,5,0,0"/>

                <TextBlock Text="{Binding SendDate, StringFormat='HH:mm dd.MM.yyyy'}"
                           FontSize="8"
                           HorizontalAlignment="Right"
                           Margin="0,5,0,0"
                           Foreground="{DynamicResource MaterialDesignBody}"/>
			</StackPanel>
		</Border>
	</Grid>
</UserControl>