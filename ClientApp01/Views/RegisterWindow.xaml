<Window x:Class="ClientApp01.Views.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Messenger - Регистрация"
        Height="650" Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        DataContext="{Binding RegisterViewModel, Source={StaticResource Locator}}">

    <Window.Resources>
        <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignTextBox}">
            <Setter Property="Margin" Value="0,10,0,0"/>
        </Style>
        <Style TargetType="PasswordBox" BasedOn="{StaticResource MaterialDesignPasswordBox}">
            <Setter Property="Margin" Value="0,10,0,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel VerticalAlignment="Center">
                <!-- Логотип -->
                <Viewbox Height="80" Margin="0,0,0,20">
                    <TextBlock Text="✉️" FontSize="40"/>
                </Viewbox>

                <!-- Заголовок -->
                <TextBlock Text="Регистрация"
                           FontSize="22"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>

                <!-- Тип регистрации -->
                <ComboBox ItemsSource="{Binding RegistrationTypes}"
                          SelectedItem="{Binding SelectedRegistrationType}"
                          DisplayMemberPath="DisplayName"
                          Margin="0,0,0,10"/>

                <!-- Поля ввода -->
                <TextBox materialDesign:HintAssist.Hint="Имя пользователя"
                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding IsUsernameEnabled}"/>

                <StackPanel Visibility="{Binding ShowPasswordFields, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <PasswordBox materialDesign:HintAssist.Hint="Пароль"
                                 x:Name="PasswordBox"/>

                    <PasswordBox materialDesign:HintAssist.Hint="Подтверждение пароля"
                                 x:Name="ConfirmPasswordBox"/>
                </StackPanel>
                <PasswordBox materialDesign:HintAssist.Hint="Пароль AD"
                 x:Name="AdPasswordBox"
                             Visibility="{Binding ShowADPasswordField, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <TextBox materialDesign:HintAssist.Hint="Email"
                         Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBox materialDesign:HintAssist.Hint="Имя"
                         Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBox materialDesign:HintAssist.Hint="Фамилия"
                         Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Ошибка -->
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="Red"
                           Margin="0,15,0,0"
                           TextWrapping="Wrap"/>

                <!-- Кнопка регистрации -->
                <Button Content="Зарегистрироваться"
                        Command="{Binding RegisterCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Margin="0,30,0,0"
                        Padding="20,5"
                        HorizontalAlignment="Stretch"/>

                <!-- Ссылка на вход -->
                <TextBlock Margin="0,20,0,0" HorizontalAlignment="Center">
                    <Hyperlink Command="{Binding NavigateToLoginCommand}">
                        Уже есть аккаунт? Войти
                    </Hyperlink>
                </TextBlock>

                <!-- Прогресс-бар -->
                <ProgressBar IsIndeterminate="True"
                             Height="5"
                             Margin="0,20,0,0"
                             Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>